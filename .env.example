# Environment template for Budget
# Copy to .env.local for Next.js and .env for Prisma CLI

# Database (SQLite for local; use Neon Postgres URL in production)
DATABASE_URL="file:./dev.db"

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Comma-separated emails allowed to create/join the workspace (invite-only gate)
ALLOWED_EMAILS=

# Plaid — https://dashboard.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions,investments
PLAID_COUNTRY_CODES=US
# Public URL of this app (used for OAuth redirects + webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
PLAID_WEBHOOK_URL=

# 32+ character secret used to encrypt Plaid access tokens at rest
TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-secret-key
