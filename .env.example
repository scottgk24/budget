# Environment template for Budget
# Copy to .env.local for Next.js and .env for Prisma CLI

# Database — Postgres (Neon recommended for local + production)
# After `vercel integration add neon`, pull with: npx vercel env pull .env.local
# Use the Neon pooled host (-pooler) and Prisma-friendly params, e.g.:
#   ...@ep-xxx-pooler....neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15
DATABASE_URL=

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Comma-separated emails allowed to create a workspace (required in production).
# Empty allowlist is open only in local/dev; production is invite-only without this.
ALLOWED_EMAILS=

# Plaid — https://dashboard.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions,investments
PLAID_COUNTRY_CODES=US
# Public URL of this app (used for OAuth redirects + webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
PLAID_WEBHOOK_URL=
# Optional redirect URI for OAuth institutions (Chase)
PLAID_REDIRECT_URI=
# Optional defense-in-depth shared secret (header: x-budget-webhook-secret).
# Plaid JWT verification is always required; this is an extra check if you proxy webhooks.
PLAID_WEBHOOK_SECRET=

# Encrypt Plaid access tokens at rest. REQUIRED — generate a unique value:
#   openssl rand -base64 32
# Do not use placeholders. Do not reuse sandbox keys in production.
TOKEN_ENCRYPTION_KEY=
